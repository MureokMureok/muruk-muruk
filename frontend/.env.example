# 백엔드 API 주소
VITE_API_BASE_URL=http://localhost:8080

# 구글 로그인 클라이언트 ID (백엔드 GOOGLE_CLIENT_ID와 같은 값)
# 팀 규칙: 값을 코드·문서·채팅·AI 도구에 올리지 않는다. 서영님께 직접 받아 내 PC .env에만 넣는다
# 주소 또는 이 값이 비어 있으면 전부 모의 데이터로 동작 (임시 이메일 로그인)
VITE_GOOGLE_CLIENT_ID=

# 실서버로 부를 함수. 예: getCampaign,purchase / 전부: all / 비우면 로그인만 실서버 (docs/api-fields.md)
VITE_REAL_APIS=
