# DB
DB_URL=jdbc:mysql://localhost:3307/muruk_muruk?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=muruk_muruk
DB_PASSWORD=
# Docker로 MySQL을 띄울 때만 사용 (스프링 서버는 읽지 않음)
DB_ROOT_PASSWORD=

# 로그인
# 구글 OAuth 클라이언트 ID (프론트와 같은 값, 비밀 아님)
GOOGLE_CLIENT_ID=
# 서버가 발급하는 토큰의 서명 키. 32바이트 이상 랜덤 문자열, 절대 커밋 금지
JWT_SECRET=
# 허용할 프론트 주소 (쉼표로 구분). 비우면 localhost:5173,3000 사용. 배포 시 Vercel 주소 추가
CORS_ALLOWED_ORIGINS=

# 체인 (RPC 주소는 NHN 제공 환경 확인 전까지 임시값 사용)
CHAIN_RPC_URL=
CHAIN_ID=
CONTRACT_ADDRESS=
# 서버 관리 지갑 키 - 절대 커밋 금지
SERVER_WALLET_PRIVATE_KEY=